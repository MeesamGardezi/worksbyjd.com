<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: "Career Opportunities — Join WORKS by JD · North Shore Boston", description: "Join the WORKS by JD team. Careers in Design-Build remodeling on the North Shore of Boston — project management, carpentry, design, and more." }) %>
<body>
<%- include('partials/navbar', { activePage: 'careers' }) %>
<%- include('partials/mobile-menu') %>
<div class="nav-offset"></div>

<section class="page-hero">
  <div class="page-hero-accent"></div>
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a><span class="breadcrumb-sep">/</span><span>Career Opportunities</span></div>
    <div class="page-hero-eyebrow">Join the Team</div>
    <h1 class="page-hero-title">Build a career <em>worth building.</em></h1>
    <p class="page-hero-body">WORKS by JD is a place where the craft is taken seriously, the people are treated right, and the work gets noticed. We're a small team that does exceptional work — and we're growing.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:16px;">
      <span class="badge badge-ember" style="font-size:11px;">Beverly, MA</span>
      <span class="badge badge-success" style="font-size:11px;">North Shore Boston</span>
      <span class="badge badge-neutral" style="font-size:11px;">Design-Build</span>
    </div>
  </div>
</section>

<!-- Open Positions -->
<section class="section-pad" style="background:var(--stone-100);">
  <div class="container">
    <div class="section-header"><div class="section-eyebrow">Open Positions</div><h2 class="section-title">Current <em>openings.</em></h2></div>
    <div style="display:grid;gap:20px;margin-top:48px;">

    <% if (careers && careers.length > 0) { %>
      <% careers.forEach(function(c) { %>
      <div style="background:white;border-radius:var(--r-2xl);padding:40px;box-shadow:var(--shadow-card);display:grid;grid-template-columns:1fr auto;gap:32px;align-items:start;">
        <div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
            <span class="badge badge-ember"><%= c.type %></span><span class="badge badge-neutral"><%= c.location %></span>
          </div>
          <h3 style="font-family:var(--font-display);font-size:24px;font-weight:700;color:var(--color-heading);margin-bottom:10px;"><%= c.title %></h3>
          <p style="font-size:15px;color:var(--color-body);line-height:1.7;margin-bottom:16px;"><%= c.description %></p>
          <% if (c.requirements && c.requirements.trim()) { %>
          <div style="font-size:13px;font-weight:700;color:var(--color-heading);margin-bottom:8px;">We're looking for:</div>
          <ul style="font-size:14px;color:var(--color-body);line-height:1.8;padding-left:20px;margin:0;">
            <% c.requirements.split('\n').filter(function(r){ return r.trim(); }).forEach(function(req) { %>
            <li><%= req.trim() %></li>
            <% }); %>
          </ul>
          <% } %>
        </div>
        <div style="text-align:right;min-width:160px;">
          <% if (c.salary) { %>
          <div style="font-size:20px;font-family:var(--font-display);font-weight:700;color:var(--ember-600);white-space:nowrap;"><%= c.salary %></div>
          <% } %>
          <% if (c.salaryNote) { %>
          <div style="font-size:12px;color:var(--color-body-subtle);margin-bottom:16px;"><%= c.salaryNote %></div>
          <% } %>
          <a href="/contact" class="btn btn-primary btn-sm">Apply Now</a>
        </div>
      </div>
      <% }); %>
    <% } else { %>
      <div style="background:white;border-radius:var(--r-2xl);padding:60px 40px;box-shadow:var(--shadow-card);text-align:center;">
        <div style="font-size:48px;margin-bottom:16px;">🔨</div>
        <h3 style="font-family:var(--font-display);font-size:22px;font-weight:700;color:var(--color-heading);margin-bottom:10px;">No open positions right now.</h3>
        <p style="font-size:15px;color:var(--color-body);line-height:1.7;max-width:520px;margin:0 auto 20px;">We're not actively hiring at the moment, but we're always interested in hearing from talented people. Send us a message and we'll keep you in mind.</p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    <% } %>

    </div>
  </div>
</section>

<!-- Application Process -->
<section class="section-pad bg-bg">
  <div class="container">
    <div class="section-header"><div class="section-eyebrow">How to Apply</div><h2 class="section-title">A simple, <em>respectful process.</em></h2></div>
    <div class="process-steps" style="margin-top:48px;">
      <div class="process-step">
        <div class="process-step-num">01</div>
        <h3 class="process-step-title">Send a Message</h3>
        <p class="process-step-body">Use the contact form and tell us the position you're interested in, a bit about yourself, and why WORKS by JD. No resume required to start — just a thoughtful note.</p>
      </div>
      <div class="process-step">
        <div class="process-step-num">02</div>
        <h3 class="process-step-title">Phone Screen</h3>
        <p class="process-step-body">We'll schedule a 20-minute phone call to understand your background, current situation, and work style. We're not using a checklist — we're having a real conversation.</p>
      </div>
      <div class="process-step">
        <div class="process-step-num">03</div>
        <h3 class="process-step-title">Site Visit or Portfolio Review</h3>
        <p class="process-step-body">Field candidates join us on a job site. Designers and PMs do a deeper conversation and portfolio or project review. You'll see how we work, who we are, and whether it fits.</p>
      </div>
      <div class="process-step">
        <div class="process-step-num">04</div>
        <h3 class="process-step-title">Offer</h3>
        <p class="process-step-body">If we're a match, we move fast — a written offer within a week of the site visit. We don't waste good people's time.</p>
      </div>
    </div>
  </div>
</section>

<!-- Jesse on team culture -->
<section class="section-pad" style="background:var(--forge-950);">
  <div class="container" style="max-width:780px;text-align:center;">
    <div class="section-eyebrow" style="color:var(--ember-400);">A Note From Jesse</div>
    <blockquote style="font-family:var(--font-display);font-size:clamp(20px,2.5vw,30px);font-style:italic;font-weight:700;color:white;line-height:1.4;margin:24px 0;">"I started with a set of tools and a van. Everything I know about this trade — the technical stuff, the client relationships, the business building — I learned from people who took the time to teach me. I'm here to give that forward. If you're serious about this craft, I want to talk."</blockquote>
    <div style="font-size:15px;font-weight:600;color:var(--forge-300);">Jesse DeBenedictis · CRPM · CR · CKBR · CLC</div>
    <a href="/contact" class="btn btn-primary" style="margin-top:28px;">Get in Touch</a>
  </div>
</section>

<section class="cta-section">
  <div class="container"><div class="cta-inner">
    <div class="cta-eyebrow">Ready to Build Something Together?</div>
    <h2 class="cta-title">Great work requires <em>great people.</em></h2>
    <p class="cta-body">We're always interested in hearing from talented people, even when specific roles aren't posted. Reach out.</p>
    <div class="cta-buttons"><a href="/contact" class="btn btn-primary btn-lg">Apply Now</a><a href="/about/meet-the-team" class="btn btn-outline-light btn-lg">Meet the Team</a></div>
  </div></div>
</section>

<%- include('partials/footer') %>