<!-- How to Claim -->
<section class="section-pad bg-bg">
  <div class="container">
    <div class="section-header"><div class="section-eyebrow">Warranty Claims</div><h2 class="section-title">Filing a claim is <em>simple.</em></h2></div>
    <div class="process-steps" style="margin-top:48px;">
      <div class="process-step">
        <div class="process-step-num">01</div>
        <h3 class="process-step-title">Contact Us</h3>
        <p class="process-step-body">Email or call WORKS directly to describe the issue. No forms, no third parties, no call centers — you reach Jesse or your project manager directly.</p>
      </div>
      <div class="process-step">
        <div class="process-step-num">02</div>
        <h3 class="process-step-title">Site Assessment</h3>
        <p class="process-step-body">We schedule an in-person visit within 5 business days to inspect the issue, determine cause, and confirm warranty applicability.</p>
      </div>
      <div class="process-step">
        <div class="process-step-num">03</div>
        <h3 class="process-step-title">Remedy</h3>
        <p class="process-step-body">If covered, WORKS remedies the issue at no charge — scheduling, materials, and labor included. We handle manufacturer warranty claims too.</p>
      </div>
      <div class="process-step">
        <div class="process-step-num">04</div>
        <h3 class="process-step-title">Documentation</h3>
        <p class="process-step-body">All warranty service is documented in your project file and our systems. Full transparency throughout.</p>
      </div>
    </div>
  </div>
</section>

