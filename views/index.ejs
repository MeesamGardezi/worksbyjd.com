<!-- ══ CTA / LEAD FORM ══ -->
<section class="cta-section" id="contact">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 480px;gap:80px;align-items:center;position:relative;">
      <div>
        <div class="cta-eyebrow">Ready to Start?</div>
        <h2 class="cta-title" style="text-align:left;margin-left:0;margin-right:0;">
          Transform your home into the space you <em>deserve.</em>
        </h2>
        <p class="cta-body" style="text-align:left;margin-left:0;max-width:460px;">
          Schedule a free, no-obligation consultation with Jesse DeBenedictis.
          We'll come to your home, listen to your vision, and show you how the
          Design-Build process makes it real — on time, on budget, with a
          7-Year Warranty backing every detail.
        </p>
        <div class="trust-badges" style="margin-top:32px;">
          <div class="trust-badge" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);">
            <div class="trust-badge-icon" style="background:var(--ember-500);border-color:var(--ember-600);">🛡️</div>
            <div>
              <div class="trust-badge-name" style="color:white;">7-Year Warranty</div>
              <div class="trust-badge-detail" style="color:var(--forge-400);">Written into every contract</div>
            </div>
          </div>
          <div class="trust-badge" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);">
            <div class="trust-badge-icon" style="background:var(--ember-500);border-color:var(--ember-600);">🏅</div>
            <div>
              <div class="trust-badge-name" style="color:white;">NARI Certified</div>
              <div class="trust-badge-detail" style="color:var(--forge-400);">CRPM · CR · CKBR · CLC</div>
            </div>
          </div>
        </div>
      </div>

      <div class="form-card" id="start">
        <div class="form-title">Start Your Project</div>
        <div class="form-subtitle">Free consultation · No obligation · North Shore, MA</div>
        <form class="js-contact-form" novalidate>
          <div class="form-grid">
            <div class="form-group form-group-full">
              <label class="input-label" for="name">Full Name</label>
              <input class="input" type="text" id="name" name="name" placeholder="Your full name" required/>
            </div>
            <div class="form-group">
              <label class="input-label" for="email">Email</label>
              <input class="input" type="email" id="email" name="email" placeholder="you@email.com" required/>
            </div>
            <div class="form-group">
              <label class="input-label" for="phone">Phone</label>
              <input class="input" type="tel" id="phone" name="phone" placeholder="(978) 555-0100"/>
            </div>
            <div class="form-group form-group-full">
              <label class="input-label" for="service">Service Needed</label>
              <select class="select" id="service" name="service">
                <option value="">Select a service…</option>
                <option>Kitchen Remodeling</option>
                <option>Bathroom Remodeling</option>
                <option>Outdoor Living</option>
                <option>Full House Remodel</option>
                <option>Home Addition</option>
                <option>Decking</option>
                <option>Windows &amp; Doors</option>
                <option>Basement / Attic Finishing</option>
                <option>Painting &amp; Wallpapering</option>
                <option>Other / Not Sure</option>
              </select>
            </div>
            <div class="form-group form-group-full">
              <label class="input-label" for="budget">Approximate Budget</label>
              <select class="select" id="budget" name="budget">
                <option value="">Select a range…</option>
                <option>Under $25,000</option>
                <option>$25,000 – $50,000</option>
                <option>$50,000 – $100,000</option>
                <option>$100,000 – $250,000</option>
                <option>$250,000 – $500,000</option>
                <option>$500,000+</option>
              </select>
            </div>
            <div class="form-group form-group-full">
              <label class="input-label" for="message">Tell Us About Your Project</label>
              <textarea class="textarea" id="message" name="message" rows="3" placeholder="Describe your project, timeline, and any specific goals…"></textarea>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-full" style="margin-top:20px;">Schedule My Free Consultation</button>
          <p class="form-license">Licensed · MA CS-91245 · HIC-178604 · Fully Insured · 7-Year Warranty</p>
        </form>
      </div>
    </div>
  </div>
</section>

