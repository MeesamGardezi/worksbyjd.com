<!-- ══ HEALTHY HOME ══ -->
<section class="section-pad" style="background:white;">
  <div class="container">
    <div class="healthy-home-grid">

      <!-- Left: intro -->
      <div class="healthy-home-intro">
        <div class="section-eyebrow">Built Different</div>
        <h2 class="section-title healthy-title" style="text-align:left;margin-bottom:24px;">A home that's <span class="healthy-word-1">beautiful</span> <em class="healthy-word-2">and healthy.</em></h2>
        <p class="section-body-wide" style="margin-bottom:0;">We consider more than aesthetics. Every material, system, and finish we specify is chosen with your family's long-term wellbeing in mind — not just how it looks on day one.</p>
      </div>

      <!-- Right: feature cards -->
      <div class="healthy-home-cards">
        <div class="why-card">
          <div class="why-title">Air Quality &amp; Ventilation</div>
          <p class="why-body">We specify low-VOC and zero-VOC paints, finishes, and adhesives throughout. Proper ventilation design — especially in kitchens and bathrooms — ensures your home breathes as cleanly as it looks.</p>
          <div class="healthy-tag">Materials matter</div>
        </div>
        <div class="why-card">
          <div class="why-title">Natural Light &amp; Circadian Design</div>
          <p class="why-body">Strategic window placement, skylights, and lighting plans designed to support your body's natural rhythms — not just fill a room. We consider how light moves through your space at every hour of the day.</p>
          <div class="healthy-tag">Light-first planning</div>
        </div>
        <div class="why-card">
          <div class="why-title">Non-Toxic Materials</div>
          <p class="why-body">Formaldehyde-free cabinetry, natural stone over synthetic surfaces where appropriate, and hardwood or tile over wall-to-wall carpet. We guide you toward choices that are durable, beautiful, and safe for your family.</p>
          <div class="healthy-tag">Better selections</div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ══ PROCESS ══ -->
<section class="section-pad" style="background:var(--stone-50);">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">How It Works</div>
      <h2 class="section-title">3-Step Design-Build Process</h2>
    </div>

    <div class="process-layout">
      <div class="timeline">
        <!-- Step 1 -->
        <div class="timeline-item">
          <div class="timeline-marker">
            <div class="timeline-num">1</div>
            <div class="timeline-line"></div>
          </div>
          <div class="timeline-body">
            <div class="section-eyebrow" style="margin-bottom:12px;">Step 1</div>
            <h3 class="timeline-title">Plan It.</h3>
            <p class="timeline-desc">Lock in your exact budget and design before we touch a single tool — so you'll never face those dreaded mid-project cost surprises that derail most renovations.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="timeline-item">
          <div class="timeline-marker">
            <div class="timeline-num">2</div>
            <div class="timeline-line"></div>
          </div>
          <div class="timeline-body">
            <div class="section-eyebrow" style="margin-bottom:12px;">Step 2</div>
            <h3 class="timeline-title">Build It.</h3>
            <p class="timeline-desc">Your dedicated Lead Carpenter treats your home like their own — delivering precision craftsmanship while keeping you informed daily, so you always know what's happening.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="timeline-item timeline-item-last">
          <div class="timeline-marker">
            <div class="timeline-num timeline-num-accent">3</div>
          </div>
          <div class="timeline-body">
            <div class="section-eyebrow" style="margin-bottom:12px;">Step 3</div>
            <h3 class="timeline-title">Back It.</h3>
            <p class="timeline-desc">Walk through your finished dream space with complete confidence — protected by our industry-leading 7-Year Warranty and preserved in professional photography you'll treasure forever.</p>
          </div>
        </div>
      </div>

      <div class="process-diagram">
        <img src="/processdiagram_nobg.png" alt="WORKS by JD 3-Step Design-Build Process Diagram" loading="lazy">
      </div>
    </div>

    <div style="text-align:center;margin-top:56px;">
      <a href="/about" class="btn btn-outline btn-lg" style="margin-right:16px;">Learn More</a>
      <a href="/contact" class="btn btn-primary btn-lg">Start With a Free Consultation</a>
    </div>
  </div>
</section>

