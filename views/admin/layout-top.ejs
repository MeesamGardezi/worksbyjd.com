<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin' %> — WORKS by JD</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --admin-bg: #FAF8F5;
      --admin-sidebar: #1A1714;
      --admin-card: #FFFFFF;
      --admin-border: #E8E2DA;
      --admin-text: #1A1714;
      --admin-muted: #8A7E72;
      --admin-ember: #C06A2C;
      --admin-ember-light: #FFF5ED;
      --admin-green: #16A34A;
      --admin-green-light: #F0FDF4;
      --admin-red: #DC2626;
      --admin-red-light: #FEF2F2;
      --admin-blue: #2563EB;
      --admin-blue-light: #EFF6FF;
    }
    body { font-family: 'Inter', -apple-system, sans-serif; background: var(--admin-bg); color: var(--admin-text); display: flex; min-height: 100vh; }

    /* Sidebar */
    .sidebar { width: 240px; background: var(--admin-sidebar); color: white; padding: 24px 0; flex-shrink: 0; position: fixed; top: 0; left: 0; bottom: 0; overflow-y: auto; }
    .sidebar-logo { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 800; padding: 0 24px; margin-bottom: 8px; color: white; }
    .sidebar-sub { font-size: 11px; color: rgba(255,255,255,0.4); padding: 0 24px; margin-bottom: 32px; text-transform: uppercase; letter-spacing: 1.5px; }
    .sidebar-nav a { display: flex; align-items: center; gap: 12px; padding: 10px 24px; color: rgba(255,255,255,0.65); font-size: 14px; font-weight: 500; text-decoration: none; transition: all 0.15s; }
    .sidebar-nav a:hover, .sidebar-nav a.active { color: white; background: rgba(255,255,255,0.08); }
    .sidebar-nav a.active { border-left: 3px solid var(--admin-ember); padding-left: 21px; }
    .sidebar-nav .nav-icon { width: 18px; font-size: 16px; text-align: center; }
    .sidebar-divider { height: 1px; background: rgba(255,255,255,0.08); margin: 16px 24px; }
    .sidebar-bottom { position: absolute; bottom: 24px; left: 0; right: 0; padding: 0 24px; }
    .sidebar-bottom a { color: rgba(255,255,255,0.4); font-size: 13px; text-decoration: none; }
    .sidebar-bottom a:hover { color: white; }

    /* Main area */
    .main { margin-left: 240px; flex: 1; padding: 32px 40px; }
    .page-header { margin-bottom: 32px; }
    .page-title { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 800; color: var(--admin-text); }
    .page-subtitle { color: var(--admin-muted); font-size: 14px; margin-top: 4px; }

    /* Cards */
    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px; }
    .stat-card { background: var(--admin-card); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px; }
    .stat-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--admin-muted); margin-bottom: 8px; }
    .stat-value { font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 800; color: var(--admin-text); }
    .stat-sub { font-size: 12px; color: var(--admin-muted); margin-top: 4px; }

    .card { background: var(--admin-card); border: 1px solid var(--admin-border); border-radius: 12px; padding: 24px; margin-bottom: 24px; }
    .card-title { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; margin-bottom: 16px; }

    /* Tables */
    .table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .table th { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--admin-muted); text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--admin-border); }
    .table td { padding: 12px; border-bottom: 1px solid var(--admin-border); vertical-align: middle; }
    .table tr:last-child td { border-bottom: none; }
    .table tr:hover td { background: var(--admin-bg); }
    .table a { color: var(--admin-ember); text-decoration: none; font-weight: 500; }
    .table a:hover { text-decoration: underline; }

    /* Badges */
    .badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-new { background: var(--admin-ember-light); color: var(--admin-ember); }
    .badge-contacted { background: var(--admin-blue-light); color: var(--admin-blue); }
    .badge-closed { background: var(--admin-green-light); color: var(--admin-green); }
    .badge-archived { background: #F5F5F4; color: #78716C; }

    /* Buttons */
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none; border: none; cursor: pointer; transition: all 0.15s; }
    .btn-ember { background: var(--admin-ember); color: white; }
    .btn-ember:hover { background: #A85A24; }
    .btn-outline { background: transparent; border: 1px solid var(--admin-border); color: var(--admin-text); }
    .btn-outline:hover { background: var(--admin-bg); }
    .btn-red { background: var(--admin-red-light); color: var(--admin-red); border: 1px solid #FECACA; }
    .btn-red:hover { background: #FEE2E2; }
    .btn-sm { padding: 6px 14px; font-size: 13px; }

    /* Forms */
    .form-group { margin-bottom: 20px; }
    .form-label { display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--admin-muted); margin-bottom: 8px; }
    .form-input, .form-select, .form-textarea { width: 100%; padding: 10px 14px; border: 1px solid var(--admin-border); border-radius: 8px; font-size: 14px; font-family: inherit; outline: none; transition: border-color 0.15s; }
    .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--admin-ember); }
    .form-textarea { resize: vertical; min-height: 100px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-grid-full { grid-column: 1 / -1; }

    .alert { padding: 14px 18px; border-radius: 8px; font-size: 14px; margin-bottom: 20px; }
    .alert-success { background: var(--admin-green-light); color: var(--admin-green); border: 1px solid #BBF7D0; }

    /* Chart placeholder */
    .chart-bar { display: flex; align-items: end; gap: 4px; height: 120px; margin-top: 12px; }
    .chart-col { flex: 1; background: var(--admin-ember); border-radius: 4px 4px 0 0; min-height: 4px; transition: height 0.3s; position: relative; }
    .chart-col:hover { opacity: 0.8; }
    .chart-col .tip { display: none; position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%); background: var(--admin-sidebar); color: white; font-size: 11px; padding: 4px 8px; border-radius: 4px; white-space: nowrap; z-index: 2; }
    .chart-col:hover .tip { display: block; }

    .empty { text-align: center; padding: 40px 20px; color: var(--admin-muted); }
    .empty-icon { font-size: 40px; margin-bottom: 12px; }

    @media (max-width: 768px) {
      .sidebar { display: none; }
      .main { margin-left: 0; padding: 20px; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .form-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-logo">WORKS by JD</div>
    <div class="sidebar-sub">Admin Panel</div>
    <nav class="sidebar-nav">
      <a href="/admin" class="<%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>"><span class="nav-icon">📊</span> Dashboard</a>
      <a href="/admin/contacts" class="<%= typeof activePage !== 'undefined' && activePage === 'contacts' ? 'active' : '' %>"><span class="nav-icon">📬</span> Contacts</a>
      <a href="/admin/analytics" class="<%= typeof activePage !== 'undefined' && activePage === 'analytics' ? 'active' : '' %>"><span class="nav-icon">📈</span> Analytics</a>
      <a href="/admin/careers" class="<%= typeof activePage !== 'undefined' && activePage === 'careers' ? 'active' : '' %>"><span class="nav-icon">💼</span> Careers</a>
      <a href="/admin/settings" class="<%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'active' : '' %>"><span class="nav-icon">⚙️</span> Settings</a>
      <div class="sidebar-divider"></div>
      <a href="/" target="_blank"><span class="nav-icon">🌐</span> View Site</a>
    </nav>
    <div class="sidebar-bottom">
      <a href="/admin/logout">Sign Out →</a>
    </div>
  </aside>
  <main class="main">
