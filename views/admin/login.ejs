<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Login — WORKS by JD</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', -apple-system, sans-serif; background: #FAF8F5; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .login-card { background: white; border: 1px solid #E8E2DA; border-radius: 16px; padding: 48px 40px; width: 100%; max-width: 400px; box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
    .login-logo { font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 800; color: #1A1714; text-align: center; margin-bottom: 8px; }
    .login-sub { text-align: center; color: #8A7E72; font-size: 14px; margin-bottom: 32px; }
    .field { margin-bottom: 20px; }
    .field label { display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: #8A7E72; margin-bottom: 8px; }
    .field input { width: 100%; padding: 12px 16px; border: 1px solid #E8E2DA; border-radius: 8px; font-size: 15px; outline: none; transition: border-color 0.15s; }
    .field input:focus { border-color: #C06A2C; }
    .btn { width: 100%; padding: 14px; background: #C06A2C; color: white; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; transition: background 0.15s; }
    .btn:hover { background: #A85A24; }
    .error { background: #FEF2F2; color: #B91C1C; border: 1px solid #FECACA; border-radius: 8px; padding: 12px 16px; font-size: 14px; margin-bottom: 20px; }
    a { color: #C06A2C; text-decoration: none; }
  </style>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
</head>
<body>
  <div class="login-card">
    <div class="login-logo">WORKS by JD</div>
    <div class="login-sub">Admin Panel</div>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/admin/login">
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter admin password" autofocus required/>
      </div>
      <button type="submit" class="btn">Sign In</button>
    </form>
    <p style="text-align:center;margin-top:24px;font-size:13px;color:#8A7E72;"><a href="/">← Back to site</a></p>
  </div>
</body>
</html>
